#!/sbin/openrc-run
description="Alpenglow first boot: expand rootfs, machine-id, host keys"

depend() {
    need localmount
    after root
    before dropbear
}

start() {
    ebegin "Alpenglow first boot"

    MARK=/var/lib/alpenglow/.firstboot-done
    if [ -f "$MARK" ]; then
        eend 0 "already done"
        rc-update del alpenglow-firstboot default 2>/dev/null
        return 0
    fi

    FAIL=0

    # 1. 扩展根分区
    ROOT_DEV=$(findmnt -n -o SOURCE /)
    if [ "$ROOT_DEV" = "/dev/root" ] || [ -z "$ROOT_DEV" ]; then
        ROOT_DEV=$(readlink -f /dev/root 2>/dev/null || echo "$ROOT_DEV")
    fi
    case "$ROOT_DEV" in
        *p[0-9]*)
            DISK=$(echo "$ROOT_DEV" | sed 's/p[0-9]*$//')
            PARTNUM=$(echo "$ROOT_DEV" | sed 's/.*p//')
            ;;
        *)
            DISK=$(echo "$ROOT_DEV" | sed 's/[0-9]*$//')
            PARTNUM=$(echo "$ROOT_DEV" | sed 's/.*[^0-9]//')
            ;;
    esac
    if [ -n "$DISK" ] && [ -n "$PARTNUM" ]; then
        parted -s "$DISK" resizepart "$PARTNUM" 100% 2>/dev/null || FAIL=1
        sleep 1
        partx -u "$DISK" 2>/dev/null
        sleep 1
        resize2fs "$ROOT_DEV" 2>/dev/null || FAIL=1
    fi

    # 2. machine-id
    if [ ! -s /etc/machine-id ]; then
        dd if=/dev/urandom bs=16 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' > /etc/machine-id || FAIL=1
    fi

    # 3. Dropbear ed25519 host key
    if [ ! -f /etc/dropbear/dropbear_ed25519_host_key ]; then
        mkdir -p /etc/dropbear
        chmod 700 /etc/dropbear
        dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1 || FAIL=1
    fi

    # 4. default root password (no serial console case)
    if ! grep -q '^root:[^:!*]' /etc/shadow 2>/dev/null; then
        echo "root:alpenglow" | chpasswd 2>/dev/null
    fi

    # 5. 标记 + 自我禁用（仅成功时）
    if [ "$FAIL" -eq 0 ]; then
        mkdir -p "$(dirname "$MARK")"
        touch "$MARK"
        rc-update del alpenglow-firstboot default 2>/dev/null
        eend 0
    else
        ewarn "firstboot had errors, will retry next boot"
        eend 1
    fi
}
