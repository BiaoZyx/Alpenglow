#!/bin/sh
# Alpenglow control center

VERSION="1.1"
P=$(printf '\033[38;5;135m')
D=$(printf '\033[2m')
ERRC=$(printf '\033[38;5;204m')
R=$(printf '\033[0m')

USB_UDC=/tmp/usb/usb_gadget/cvitek/UDC
TEMP=/sys/class/thermal/thermal_zone0/temp

err() { printf '%serror:%s %s\n' "$ERRC" "$R" "$*" >&2; }
hdr() { printf '%s== %s ==%s\n' "$P" "$*" "$R"; }

# confirm "Question" -> answers on a tty; non-tty proceeds (automation)
confirm() {
    [ -t 0 ] || return 0
    local _c
    printf '%s%s? %s[Y/n]%s: ' "$P" "$1" "$D" "$R"
    if ! IFS= read -r _c; then
        echo >&2
        err "aborted"
        return 1
    fi
    case "${_c:-Y}" in
        [Yy]*) return 0 ;;
        *) err "aborted"; return 1 ;;
    esac
}

# suggest TYPED CANDIDATE... -> dim "Did you mean:" hint on stderr
# matches: candidate contains the typed word, or both share the first 3 letters
suggest() {
    local _typed _c _cl _hits="" _t3 _c3 _c2 _t2
    _typed=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
    _t3=$(printf '%.3s' "$_typed")
    shift
    for _c in "$@"; do
        _cl=$(printf '%s' "$_c" | tr 'A-Z' 'a-z')
        case "$_cl" in
            *"$_typed"*) _hits="$_hits $_c"; continue ;;
        esac
        _c3=$(printf '%.3s' "$_cl")
        if [ "$_c3" = "$_t3" ]; then
            _hits="$_hits $_c"
            continue
        fi
        # same length + same first 2 letters: catches scna -> scan
        if [ "${#_cl}" -eq "${#_typed}" ]; then
            _c2=$(printf '%.2s' "$_cl")
            _t2=$(printf '%.2s' "$_typed")
            [ "$_c2" = "$_t2" ] && _hits="$_hits $_c"
        fi
    done
    [ -n "$_hits" ] || return 0
    printf '%s  Did you mean:%s%s\n' "$D" "$R" "$_hits" >&2
}

usage() {
    printf "${P}Alpenglow %s${R} - control center\n\n" "$VERSION"
    cat <<EOF
  all info                  system overview
  all net                   interfaces, IP, routes, DNS
  all ports                 listening TCP ports
  all ssh                   SSH address and fingerprint
  all logs [kernel|service] kernel log, or service status + log tail
  all hostname [name]       show or set the hostname
  all doctor                self-check services and tools (non-zero on issues)
  all temp                  thermal and CPU frequency
  all growfs                expand rootfs to fill the SD card
  all backup [dir]          back up /home and /etc

  all wifi                  Wi-Fi control (wpa_supplicant)
    all wifi scan           scan networks
    all wifi list           saved networks
    all wifi status         current connection + IP
    all wifi connect <SSID> [password] [priority]
    all wifi select <id>    switch to saved network by id
    all wifi enable <id>    enable saved network
    all wifi disable <id>   disable saved network
    all wifi forget <id>    remove a saved network
    all wifi disconnect     drop current connection
    all wifi reassociate    reconnect to current network
    all wifi save           persist config to disk

  all usb                   USB RNDIS gadget status
    all usb restart         restart gadget

  all gpio
    all gpio list              list gpiochips and lines
    all gpio func <pin>        show pin function (duo-pinmux)
    all gpio set <pin>/<func>  switch pin function (duo-pinmux)
    all gpio get <chip> <line> read line level (libgpiod)
    all gpio put <chip> <line> <0|1>  set line level (libgpiod)
    all gpio wiringx           wiringX library location and hint

  (every command accepts --help)
EOF
}

# format tab-separated input into aligned columns
format_table() {
    awk -F'\t' '
    { for (i=1;i<=NF;i++) if (length($i)>w[i]) w[i]=length($i); n=NR; line[NR]=$0 }
    END {
        for (r=1;r<=n;r++) {
            nf = split(line[r], f, "\t")
            for (i=1;i<nf;i++) {
                printf "%s", f[i]
                pad = w[i] - length(f[i]) + 2
                while (pad-- > 0) printf " "
            }
            printf "%s\n", f[nf]
        }
    }'
}


iface_table() {
    local rows
    rows=$(
        ip -o link 2>/dev/null | while IFS= read -r line; do
            iface=$(printf '%s' "$line" | awk -F': ' '{print $2}')
            case "$iface" in
                ""|lo|sit*|*@*) continue ;;
            esac
            state=DOWN
            case "$line" in
                *'<UP'*|*',UP'*) state=UP ;;
            esac
            v4=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk 'NR==1{print $4}')
            v6=$(ip -6 -o addr show dev "$iface" scope global 2>/dev/null | awk 'NR==1{print $4}')
            if [ -z "$v6" ]; then
                v6=$(ip -6 -o addr show dev "$iface" 2>/dev/null | awk '$4 !~ /^::1/{print $4; exit}')
                case "$v6" in
                    fe80:*) v6="$v6 (link-local)" ;;
                esac
            fi
            printf "%s\t%s\t%s\t%s\n" "$iface" "$state" "${v4:--}" "${v6:--}"
        done
    )
    if [ -z "$rows" ]; then
        printf '%s  No interfaces.%s\n' "$D" "$R"
        return 0
    fi
    { printf "IFACE\tSTATE\tIPv4\tIPv6\n"; printf '%s\n' "$rows"; } | format_table
}

info() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    local host kern up mem storage temp usb eth wifi
    host=$(hostname 2>/dev/null || echo "alpenglow")
    kern=$(uname -r 2>/dev/null || echo "n/a")
    up=$(awk '{printf "%dh%02dm", $1/3600, ($1%3600)/60}' /proc/uptime 2>/dev/null || echo "n/a")
    mem=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%dM used / %dM total", (t-a)/1024, t/1024}' /proc/meminfo 2>/dev/null || echo "n/a")
    storage=$(df -hP / 2>/dev/null | awk 'NR==2{print $3" used / "$2" total"}')
    [ -n "$storage" ] || storage="n/a"
    temp=$(awk '{printf "%.1f°C", $1/1000}' "$TEMP" 2>/dev/null || echo "n/a")
    eth=$(ip -4 -o addr show eth0 2>/dev/null | awk 'NR==1{print $4}')
    [ -n "$eth" ] || eth="down"
    wifi=$(ip -4 -o addr show wlan0 2>/dev/null | awk 'NR==1{print $4}')
    if [ -z "$wifi" ]; then
        if [ -e /sys/class/net/wlan0 ]; then
            wifi=$(cat /sys/class/net/wlan0/operstate 2>/dev/null || echo "down")
        else
            wifi="absent"
        fi
    fi
    usb=$(ip -4 -o addr show usb0 2>/dev/null | awk 'NR==1{print $4}')
    [ -n "$usb" ] || usb="down"

    printf "${P}Alpenglow %s${R} on %s\n" "$VERSION" "$host"
    printf "  ${D}%-8s${R} %s\n" "kernel"  "$kern"
    printf "  ${D}%-8s${R} %s\n" "uptime"  "$up"
    printf "  ${D}%-8s${R} %s\n" "memory"  "$mem"
    printf "  ${D}%-8s${R} %s\n" "storage" "$storage"
    printf "  ${D}%-8s${R} %s\n" "temp"    "$temp"
    printf "  ${D}%-8s${R} %s%s\n" "eth0"    "$eth"  "$(_nolink eth0)"
    printf "  ${D}%-8s${R} %s%s\n" "wlan0"   "$wifi" "$(_nolink wlan0)"
    printf "  ${D}%-8s${R} %s%s\n" "usb0"    "$usb"  "$(_nolink usb0)"
}

# _esc STRING -> backslash/quote-escape for wpa_cli quoted values
_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# _wait_assoc [EXPECTED_SSID] -> 0 once wpa_state=COMPLETED (ssid must match if given)
_wait_assoc() {
    local i st ws ss
    i=0
    while [ "$i" -lt 30 ]; do
        st=$(wpa_cli -i wlan0 status 2>/dev/null)
        ws=$(printf '%s\n' "$st" | sed -n 's/^wpa_state=//p')
        ss=$(printf '%s\n' "$st" | sed -n 's/^ssid=//p')
        if [ "$ws" = "COMPLETED" ]; then
            if [ -z "${1:-}" ] || [ "$ss" = "$1" ]; then
                return 0
            fi
        fi
        sleep 0.5 2>/dev/null || sleep 1
        i=$((i + 1))
    done
    return 1
}

# _nolink IFACE -> " (no link)" when the iface exists but carrier is down
_nolink() {
    local c
    c=$(cat "/sys/class/net/$1/carrier" 2>/dev/null) || return 0
    if [ "$c" = "0" ]; then
        printf ' (no link)'
    fi
    return 0
}

_wpa() {
    local out rc
    out=$(wpa_cli -i wlan0 "$@" 2>&1)
    rc=$?
    case "$out" in
        OK)          return 0 ;;
        FAIL)        err "$* failed"; return 1 ;;
        "")          return "$rc" ;;
        *)           printf '%s\n' "$out"; return "$rc" ;;
    esac
}

_wpa_ready() {
    command -v wpa_cli >/dev/null 2>&1 || return 1
    wpa_cli -i wlan0 status 2>/dev/null | grep -q '^wpa_state='
}

_wifi_need_suppl() {
    if ! command -v wpa_cli >/dev/null 2>&1; then
        err "wpa_cli not installed"
        printf '%s  Run:%s apk add wpa_supplicant\n' "$D" "$R" >&2
        return 1
    fi
    if ! wpa_cli -i wlan0 status 2>/dev/null | grep -q '^wpa_state='; then
        err "wpa_supplicant not running"
        printf '%s  Run:%s rc-service wpa_supplicant start\n' "$D" "$R" >&2
        return 1
    fi
    return 0
}

_hint_save() {
    printf '%s  Not persisted yet - Run: all wifi save%s\n' "$D" "$R"
}

wifi_help() {
    printf "${P}all wifi${R} - Wi-Fi control (wpa_supplicant)\n\n"
    cat <<EOF
  all wifi scan           scan networks
  all wifi list           saved networks
  all wifi status         current connection + IP
  all wifi connect <SSID> [password] [priority]
  all wifi select <id>    switch to saved network by id
  all wifi enable <id>    enable saved network
  all wifi disable <id>   disable saved network
  all wifi forget <id>    remove a saved network
  all wifi disconnect     drop current connection
  all wifi reassociate    reconnect to current network
  all wifi save           persist config to disk
EOF
}

wifi() {
    case "${1:-}" in
        ""|help|-h|--help)
            wifi_help
            return 0
            ;;
        scan|list|status|connect|disconnect|reassociate|save)
            ;;
        select|enable|disable|forget)
            case "${2:-}" in
                ""|*[!0-9]*)
                    err "usage: all wifi $1 <id>"
                    return 1
                    ;;
            esac
            ;;
        *)
            err "unknown wifi subcommand: $1"
            suggest "$1" scan list status connect select enable disable forget disconnect reassociate save
            wifi_help >&2
            return 1
            ;;
    esac
    _wifi_need_suppl || return 1
    case "$1" in
        scan)
            _wpa scan || return 1
            sleep 3
            results=$(wpa_cli -i wlan0 scan_results 2>/dev/null | tail -n +2)
            if [ -z "$results" ]; then
                printf '%s  No scan results.%s\n' "$D" "$R"
                return 0
            fi
            {
                printf 'BSSID\tFREQUENCY\tSIGNAL\tFLAGS\tSSID\n'
                printf '%s\n' "$results"
            } | format_table
            ;;
        list)
            rows=$(wpa_cli -i wlan0 list_networks 2>/dev/null | tail -n +2)
            if [ -z "$rows" ]; then
                printf '%s  No saved networks.%s\n' "$D" "$R"
                return 0
            fi
            {
                printf "ID\tSSID\tBSSID\tFLAGS\tPRIORITY\n"
                printf '%s\n' "$rows" | while IFS="$(printf '\t')" read -r id ssid bssid flags; do
                    [ -n "$id" ] || continue
                    prio=$(wpa_cli -i wlan0 get_network "$id" priority 2>/dev/null | tail -1)
                    [ -n "$prio" ] || prio="-"
                    [ -n "$ssid" ] || ssid="(hidden)"
                    printf "%s\t%s\t%s\t%s\t%s\n" "$id" "$ssid" "$bssid" "$flags" "$prio"
                done
            } | format_table
            ;;
        status)
            st=$(wpa_cli -i wlan0 status 2>/dev/null)
            wsta=$(printf '%s\n' "$st" | sed -n 's/^wpa_state=//p' | head -n 1)
            wssid=$(printf '%s\n' "$st" | sed -n 's/^ssid=//p' | head -n 1)
            wip=$(printf '%s\n' "$st" | sed -n 's/^ip_address=//p' | head -n 1)
            wbssid=$(printf '%s\n' "$st" | sed -n 's/^bssid=//p' | head -n 1)
            wfreq=$(printf '%s\n' "$st" | sed -n 's/^freq=//p' | head -n 1)
            wsig=$(printf '%s\n' "$st" | sed -n 's/^signal=//p' | head -n 1)
            printf "${P}Wi-Fi status${R}\n"
            printf "  ${D}%-9s${R} %s\n" "state" "${wsta:--}"
            printf "  ${D}%-9s${R} %s\n" "ssid" "${wssid:--}"
            printf "  ${D}%-9s${R} %s\n" "address" "${wip:--}"
            printf "  ${D}%-9s${R} %s\n" "bssid" "${wbssid:--}"
            if [ -n "$wfreq" ]; then
                printf "  ${D}%-9s${R} %s MHz\n" "freq" "$wfreq"
            fi
            if [ -n "$wsig" ]; then
                printf "  ${D}%-9s${R} %s dBm\n" "signal" "$wsig"
            fi
            if [ "$wsta" != "COMPLETED" ]; then
                printf '%s  Not connected - Run: all wifi scan, then all wifi connect <SSID>%s\n' "$D" "$R"
            fi
            ;;
        connect)
            local ssid="${2:-}" psk="${3:-}" prio="${4:-0}" netid out
            local dups keep old_km rebuild=0 enc rows flags nid nssid _rest
            local _b _f _s flg sssid
            if [ -z "$ssid" ]; then
                [ -t 0 ] || { err "connect without SSID needs a terminal"; return 1; }
                _wpa scan || return 1
                sleep 3
                {
                    printf 'BSSID\tFREQUENCY\tSIGNAL\tFLAGS\tSSID\n'
                    wpa_cli -i wlan0 scan_results 2>/dev/null | tail -n +2
                } | format_table
                printf "SSID: "
                if ! IFS= read -r ssid; then
                    echo >&2
                    err "aborted"
                    return 1
                fi
                [ -n "$ssid" ] || { err "aborted"; return 1; }
                printf "Password (empty for open): "
                stty -echo 2>/dev/null || true
                trap 'stty echo 2>/dev/null || true' INT
                if ! IFS= read -r psk; then
                    stty echo 2>/dev/null || true
                    trap - INT
                    echo >&2
                    err "aborted"
                    return 1
                fi
                stty echo 2>/dev/null || true
                trap - INT
                echo
                printf "Priority [0]: "
                if ! IFS= read -r prio; then
                    echo >&2
                    err "aborted"
                    return 1
                fi
                prio="${prio:-0}"
            fi
            if [ -n "$psk" ]; then
                if [ "${#psk}" -lt 8 ] || [ "${#psk}" -gt 63 ]; then
                    err "Wi-Fi passphrase must be 8-63 characters"
                    return 1
                fi
            fi
            if ! printf '%s' "$prio" | grep -Eq '^-?[0-9]+$'; then
                err "priority must be an integer (got: $prio)"
                return 1
            fi
            if [ -z "$psk" ]; then
                rows=$(wpa_cli -i wlan0 scan_results 2>/dev/null | tail -n +2)
                if [ -z "$rows" ]; then
                    _wpa scan || true
                    sleep 3
                    rows=$(wpa_cli -i wlan0 scan_results 2>/dev/null | tail -n +2)
                fi
                enc=$(printf '%s\n' "$rows" | {
                    while IFS="$(printf '\t')" read -r _b _f _s flg sssid; do
                        [ "$sssid" = "$ssid" ] || continue
                        case "$flg" in
                            *WPA*|*WEP*) printf 'yes\n'; break ;;
                        esac
                    done
                })
                if [ "$enc" = "yes" ]; then
                    err "network '$ssid' is encrypted - password required"
                    printf '%s  Run:%s all wifi connect %s <password>\n' "$D" "$R" "$ssid" >&2
                    return 1
                fi
            fi
            # same SSID: update the first entry in place (id stays stable),
            # drop any extra copies; rebuild only when encryption kind changes
            dups=$(wpa_cli -i wlan0 list_networks 2>/dev/null | tail -n +2 | {
                while IFS="$(printf '\t')" read -r nid nssid _rest; do
                    [ "$nssid" = "$ssid" ] && printf '%s\n' "$nid"
                done
            })
            keep=""
            for nid in $dups; do
                if [ -z "$keep" ]; then
                    keep=$nid
                else
                    _wpa remove_network "$nid" || true
                fi
            done
            if [ -n "$keep" ]; then
                old_km=$(wpa_cli -i wlan0 get_network "$keep" key_mgmt 2>/dev/null | tail -n 1)
                case "$old_km" in
                    FAIL|"")
                        rebuild=1
                        ;;
                    *NONE*)
                        if [ -n "$psk" ]; then rebuild=1; fi
                        ;;
                    *)
                        if [ -z "$psk" ]; then rebuild=1; fi
                        ;;
                esac
                if [ "$rebuild" = 1 ]; then
                    _wpa remove_network "$keep" || true
                    keep=""
                fi
            fi
            if [ -n "$keep" ]; then
                netid=$keep
                if [ -n "$psk" ]; then
                    _wpa set_network "$netid" psk "\"$(_esc "$psk")\"" \
                        || { err "set psk failed"; return 1; }
                fi
                _wpa set_network "$netid" priority "$prio" \
                    || { err "set priority failed"; return 1; }
            else
                if ! out=$(_wpa add_network); then
                    return 1
                fi
                netid=$(printf '%s' "$out" | tail -n 1)
                case "$netid" in
                    ""|*[!0-9]*)
                        err "add_network returned '$netid'"
                        return 1
                        ;;
                esac
                _wpa set_network "$netid" ssid "\"$(_esc "$ssid")\"" \
                    || { err "set ssid failed"; return 1; }
                if [ -n "$psk" ]; then
                    _wpa set_network "$netid" psk "\"$(_esc "$psk")\"" \
                        || { err "set psk failed"; return 1; }
                else
                    _wpa set_network "$netid" key_mgmt NONE \
                        || { err "set key_mgmt failed"; return 1; }
                fi
                _wpa set_network "$netid" priority "$prio" \
                    || { err "set priority failed"; return 1; }
            fi
            _wpa enable_network "$netid" || return 1
            _wpa select_network "$netid" || return 1
            # wait for actual association before claiming success
            if _wait_assoc "$ssid"; then
                _wpa enable_network all || true
                _wpa save_config || return 1
                printf '  %sconnected%s (id %s), config saved\n' "$P" "$R" "$netid"
            else
                err "not connected (id $netid)"
                flags=$(wpa_cli -i wlan0 list_networks 2>/dev/null | tail -n +2 | {
                    while IFS="$(printf '\t')" read -r fid fsid _fb fflg _fr; do
                        if [ "$fid" = "$netid" ]; then
                            printf '%s\n' "$fflg"
                            break
                        fi
                    done
                })
                case "$flags" in
                    *TEMP-DISABLED*)
                        printf '%s  Network is temp-disabled (likely wrong password); Run: all wifi enable %s, then retry%s\n' "$D" "$netid" "$R"
                        ;;
                esac
                _wpa enable_network all || true
                _wpa save_config || true
                _wpa reassociate || true
                printf '%s  Run:%s all wifi status\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        select)
            local ssid2
            ssid2=$(wpa_cli -i wlan0 list_networks 2>/dev/null | tail -n +2 | {
                while IFS="$(printf '\t')" read -r sid sssid _r; do
                    if [ "$sid" = "$2" ]; then
                        printf '%s\n' "$sssid"
                        break
                    fi
                done
            })
            _wpa select_network "$2" || return 1
            if [ -z "$ssid2" ] || _wait_assoc "$ssid2"; then
                _wpa enable_network all || true
                _wpa save_config || return 1
                printf '  %sselected%s (id %s), config saved\n' "$P" "$R" "$2"
            else
                err "not connected (id $2)"
                _wpa enable_network all || true
                _wpa save_config || true
                _wpa reassociate || true
                printf '%s  Run:%s all wifi status\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        enable)
            _wpa enable_network "$2" || return 1
            _hint_save
            ;;
        disable)
            _wpa disable_network "$2" || return 1
            _hint_save
            ;;
        forget)
            _wpa remove_network "$2" || { err "forget $2 failed (already removed?)"; return 1; }
            _hint_save
            ;;
        disconnect)
            local i st wsta ok=0 addr
            _wpa disconnect || return 1
            i=0
            while [ "$i" -lt 10 ]; do
                st=$(wpa_cli -i wlan0 status 2>/dev/null)
                wsta=$(printf '%s\n' "$st" | sed -n 's/^wpa_state=//p')
                if [ -n "$wsta" ] && [ "$wsta" != "COMPLETED" ]; then
                    ok=1
                    break
                fi
                sleep 0.5 2>/dev/null || sleep 1
                i=$((i + 1))
            done
            if [ "$ok" != 1 ]; then
                err "disconnect failed"
                printf '%s  Run:%s all wifi status\n' "$D" "$R" >&2
                return 1
            fi
            printf '  %sdisconnected%s\n' "$P" "$R"
            addr=$(ip -4 -o addr show wlan0 2>/dev/null | awk 'NR==1{print $4}')
            if [ -n "$addr" ]; then
                printf '%s  wlan0 keeps %s until dhcpcd releases it%s\n' "$D" "$addr" "$R"
            fi
            printf '%s  Run:%s all wifi reassociate to reconnect\n' "$D" "$R"
            ;;
        reassociate)
            local st as
            _wpa reassociate || return 1
            if _wait_assoc ""; then
                st=$(wpa_cli -i wlan0 status 2>/dev/null)
                as=$(printf '%s\n' "$st" | sed -n 's/^ssid=//p')
                printf '  %sreassociated%s (ssid %s)\n' "$P" "$R" "${as:-(unknown)}"
            else
                err "reassociate failed"
                printf '%s  Run:%s all wifi status\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        save)
            _wpa save_config || return 1
            printf '  %ssaved%s config to /etc/wpa_supplicant/wpa_supplicant.conf\n' "$P" "$R"
            ;;
    esac
}

usb_help() {
    printf "${P}all usb${R} - USB RNDIS gadget\n\n"
    cat <<EOF
  all usb                 gadget status (UDC, usb0, ssh)
    all usb restart       restart gadget (drops this session)
EOF
}

usb() {
    case "${1:-}" in
        help|-h|--help)
            usb_help
            return 0
            ;;
        ""|status)
            local udc usb0 ssh_addr
            if [ -s "$USB_UDC" ]; then
                udc=$(cat "$USB_UDC")
            else
                udc="not configured"
            fi
            usb0=$(ip -4 -o addr show usb0 2>/dev/null | awk 'NR==1{print $4}')
            [ -n "$usb0" ] || usb0="down"
            ssh_addr=$(echo "$usb0" | cut -d/ -f1)

            printf "${P}USB gadget${R}\n"
            printf "  ${D}%-10s${R} %s\n" "UDC"  "$udc"
            printf "  ${D}%-10s${R} %s\n" "usb0" "$usb0"
            if [ -n "$ssh_addr" ] && [ "$ssh_addr" != "down" ]; then
                printf "  ${D}%-10s${R} root@%s\n" "ssh" "$ssh_addr"
            else
                printf "  ${D}%-10s${R} ${D}%s${R}\n" "ssh" "unavailable; run 'rc-service usb-gadget start'"
            fi
            ;;
        restart)
            confirm "Restart USB gadget (SSH session will drop)" || return 1
            echo "restarting usb-gadget; SSH session will drop"
            rc-service usb-gadget restart || { err "usb-gadget restart failed"; return 1; }
            sleep 3
            ip addr show usb0 2>/dev/null | grep -q '192.168.42.1' \
                && echo "usb0 back at 192.168.42.1" \
                || { echo "usb0 did not recover; check rc-service usb-gadget status" >&2; return 1; }
            ;;
        *)
            err "unknown usb subcommand: $1"
            suggest "$1" restart
            usb_help >&2
            return 1
            ;;
    esac
}

net() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    hdr "interfaces"
    iface_table
    echo
    hdr "ipv4 routes"
    ip -4 route 2>/dev/null || true
    echo
    hdr "ipv6 routes"
    ip -6 route 2>/dev/null || true
    echo
    hdr "resolv.conf"
    cat /etc/resolv.conf 2>/dev/null || echo "n/a"
}

__ssh_backend() {
    if command -v dropbearkey >/dev/null 2>&1; then
        echo dropbear
    elif command -v sshd >/dev/null 2>&1; then
        echo openssh
    else
        echo none
    fi
}

ssh_info() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    local backend fp pw svcname iface ip
    backend=$(__ssh_backend)
    if [ "$backend" = "none" ]; then
        err "no SSH server installed"
        printf '%s  Run:%s apk add dropbear\n' "$D" "$R" >&2
        return 1
    fi

    case "$backend" in
        dropbear)
            if [ -f /etc/dropbear/dropbear_ed25519_host_key ]; then
                fp=$(dropbearkey -y -f /etc/dropbear/dropbear_ed25519_host_key 2>/dev/null | awk '/Fingerprint/{print $2}')
            else
                fp="host key missing"
            fi
            if grep -q 'DROPBEAR_OPTS.*-w' /etc/conf.d/dropbear 2>/dev/null; then
                pw="disabled"
            else
                pw="enabled"
            fi
            svcname=dropbear
            printf "${P}SSH (Dropbear)${R}\n"
            ;;
        openssh)
            if [ -f /etc/ssh/ssh_host_ed25519_key.pub ]; then
                fp=$(ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub 2>/dev/null | awk '{print $2}')
            else
                fp="host key missing"
            fi
            if grep -qi '^PasswordAuthentication yes' /etc/ssh/sshd_config 2>/dev/null; then
                pw="enabled"
            else
                pw="disabled"
            fi
            svcname=sshd
            printf "${P}SSH (OpenSSH)${R}\n"
            ;;
    esac

    for iface in usb0 eth0 wlan0; do
        ip=$(ip -4 -o addr show "$iface" 2>/dev/null | awk 'NR==1{print $4}' | cut -d/ -f1)
        if [ -n "$ip" ]; then
            printf "  ${D}%-12s${R} root@%s\n" "$iface" "$ip"
        elif [ -d "/sys/class/net/$iface" ]; then
            printf "  ${D}%-12s${R} ${D}down${R}\n" "$iface"
        else
            printf "  ${D}%-12s${R} ${D}absent${R}\n" "$iface"
        fi
    done
    if rc-service "$svcname" status >/dev/null 2>&1; then
        printf "  ${D}%-12s${R} %sstarted%s\n" "service" "$P" "$R"
    else
        printf "  ${D}%-12s${R} %sstopped%s\n" "service" "$ERRC" "$R"
        printf "  ${D}%-12s${R} ${D}Run: rc-service %s start${R}\n" "" "$svcname"
    fi
    printf "  ${D}%-12s${R} %s\n" "fingerprint" "$fp"
    printf "  ${D}%-12s${R} %s\n" "password" "$pw"
    if [ "$pw" = "enabled" ]; then
        printf "  ${D}%-12s${R} ${D}%s${R}\n" "" "run 'passwd' to set/change root password"
    fi
}

gpio_help() {
    printf "${P}all gpio${R} - GPIO control\n\n"
    cat <<EOF
  all gpio list              list gpiochips and lines
  all gpio func <pin>        show pin function (duo-pinmux)
  all gpio set <pin>/<func>  switch pin function (duo-pinmux)
  all gpio get <chip> <line> read line level (libgpiod)
  all gpio put <chip> <line> <0|1>  set line level (libgpiod)
  all gpio wiringx           wiringX library location and hint
EOF
}

gpio() {
    case "${1:-}" in
        ""|help|-h|--help)
            gpio_help
            return 0
            ;;
        list)
            if command -v gpiodetect >/dev/null 2>&1; then
                gpiodetect
                echo
                gpioinfo 2>/dev/null | head -40
            else
                err "gpiodetect not installed"
                printf '%s  Run:%s apk add libgpiod\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        func)
            [ -n "${2:-}" ] || { err "usage: all gpio func <pin>"; return 1; }
            if command -v duo-pinmux >/dev/null 2>&1; then
                duo-pinmux -r "$2"
            else
                err "duo-pinmux not installed"
                printf '%s  It is bundled with the Alpenglow image - reflash if missing%s\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        set)
            case "${2:-}" in
                */*) ;;
                *) err "usage: all gpio set <pin>/<func>"; return 1 ;;
            esac
            if command -v duo-pinmux >/dev/null 2>&1; then
                confirm "Switch pin $2" || return 1
                duo-pinmux -w "$2"
            else
                err "duo-pinmux not installed"
                printf '%s  It is bundled with the Alpenglow image - reflash if missing%s\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        get)
            [ -n "${2:-}" ] && [ -n "${3:-}" ] || { err "usage: all gpio get <chip> <line>"; return 1; }
            if command -v gpioget >/dev/null 2>&1; then
                gpioget -c "$2" "$3"
            else
                err "gpioget not installed"
                printf '%s  Run:%s apk add libgpiod\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        put)
            [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || {
                err "usage: all gpio put <chip> <line> <0|1>"; return 1; }
            case "$4" in
                0|1) ;;
                *) err "value must be 0 or 1 (got: $4)"; return 1 ;;
            esac
            if command -v gpioset >/dev/null 2>&1; then
                confirm "Drive $2:$3 to $4" || return 1
                gpioset -c "$2" "$3=$4" || { err "gpioset failed"; return 1; }
            else
                err "gpioset not installed"
                printf '%s  Run:%s apk add libgpiod\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        wiringx)
            if [ -f /usr/local/include/wiringx.h ]; then
                echo "wiringX: /usr/local/lib/libwiringx.so"
                echo "platform: milkv_duos"
                echo "compile: gcc -o test test.c -I/usr/local/include -L/usr/local/lib -lwiringx"
                echo "run:     LD_LIBRARY_PATH=/usr/local/lib ./test"
                echo
                if [ -f /usr/local/share/alpenglow/duos-map.txt ]; then
                    { printf "IDX\tNAME\tPHYS\n"; cat /usr/local/share/alpenglow/duos-map.txt; } | format_table
                else
                    echo "(pin map not bundled)"
                fi
            else
                err "wiringX not installed"
                printf '%s  Run:%s apk add wiringx (or reflash the image)%s\n' "$D" "$R" >&2
                return 1
            fi
            ;;
        *)
            err "unknown gpio subcommand: $1"
            suggest "$1" list func set get put wiringx
            gpio_help >&2
            return 1
            ;;
    esac
}

doctor() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    local ssh_backend svc ISSUES=0 gpiod_hint=0
    ssh_backend=$(__ssh_backend)

    hdr "services"
    for svc in dhcpcd wpa_supplicant dnsmasq usb-gadget alpenglow-led alpenglow-modules local; do
        if rc-service "$svc" status >/dev/null 2>&1; then
            printf "  ${P}%-20s${R} started\n" "$svc"
        elif rc-service "$svc" status 2>&1 | grep -q 'stopped'; then
            printf "  ${D}%-20s${R} ${ERRC}stopped${R}\n" "$svc"
            printf "  ${D}%-20s${R} ${D}Run: rc-service %s start${R}\n" "" "$svc"
            ISSUES=$((ISSUES + 1))
        else
            printf "  ${D}%-20s${R} ${ERRC}not found${R}\n" "$svc"
            ISSUES=$((ISSUES + 1))
        fi
    done
    if [ -f /var/lib/alpenglow/.firstboot-done ]; then
        printf "  ${P}%-20s${R} done\n" "alpenglow-firstboot"
    elif rc-service alpenglow-firstboot status >/dev/null 2>&1; then
        printf "  ${P}%-20s${R} running\n" "alpenglow-firstboot"
    else
        printf "  ${D}%-20s${R} pending\n" "alpenglow-firstboot"
    fi

    echo
    hdr "ssh"
    case "$ssh_backend" in
        dropbear) printf "  ${P}%-20s${R} dropbear\n" "backend" ;;
        openssh)  printf "  ${P}%-20s${R} openssh\n" "backend" ;;
        *)        printf "  ${D}%-20s${R} none\n" "backend" ;;
    esac

    echo
    hdr "shell"
    if [ -n "$PS1" ]; then
        printf "  ${P}%-20s${R} ok\n" "PS1"
    else
        printf "  ${D}%-20s${R} default\n" "PS1"
    fi
    if [ -n "$HISTFILE" ]; then
        printf "  ${P}%-20s${R} %s\n" "HISTFILE" "$HISTFILE"
    else
        printf "  ${D}%-20s${R} unset\n" "HISTFILE"
    fi
    printf "  ${P}%-20s${R} %s\n" "locale" "${LANG:-unset}"

    echo
    hdr "tools"
    for tool in wpa_cli gpioget gpioset; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf "  ${P}%-20s${R} ok\n" "$tool"
        else
            printf "  ${D}%-20s${R} ${ERRC}missing${R}\n" "$tool"
            case "$tool" in
                wpa_cli)
                    printf "  ${D}%-20s${R} ${D}Run: apk add wpa_supplicant${R}\n" ""
                    ;;
                gpioget|gpioset)
                    if [ "$gpiod_hint" = 0 ]; then
                        printf "  ${D}%-20s${R} ${D}Run: apk add libgpiod${R}\n" ""
                        gpiod_hint=1
                    fi
                    ;;
            esac
            ISSUES=$((ISSUES + 1))
        fi
    done
    if command -v duo-pinmux >/dev/null 2>&1; then
        printf "  ${P}%-20s${R} ok\n" "duo-pinmux"
    else
        printf "  ${D}%-20s${R} ${ERRC}missing${R}\n" "duo-pinmux"
        printf "  ${D}%-20s${R} ${D}Bundled with the image - reflash if missing${R}\n" ""
        ISSUES=$((ISSUES + 1))
    fi

    echo
    hdr "hardware"
    # USB gadget (cable-dependent, report only)
    if [ -s "$USB_UDC" ]; then
        printf "  ${P}%-20s${R} configured\n" "USB gadget"
    else
        printf "  ${D}%-20s${R} not configured\n" "USB gadget"
    fi
    # Temperature of thermal
    if [ -r "$TEMP" ]; then
        printf "  ${P}%-20s${R} %s\n" "thermal" "$(awk '{printf "%.1f°C",$1/1000}' "$TEMP")"
    else
        printf "  ${D}%-20s${R} ${ERRC}missing${R}\n" "thermal"
        ISSUES=$((ISSUES + 1))
    fi
    # AIC8800
    if ls /lib/firmware/aic8800/*.bin >/dev/null 2>&1 || ls /mnt/system/firmware/aic8800/*.bin >/dev/null 2>&1; then
        printf "  ${P}%-20s${R} ok\n" "AIC8800 firmware"
    else
        printf "  ${D}%-20s${R} ${ERRC}missing${R}\n" "AIC8800 firmware"
        printf "  ${D}%-20s${R} ${D}Restore /lib/firmware/aic8800 or reflash${R}\n" ""
        ISSUES=$((ISSUES + 1))
    fi
    # duos-map(text)
    if [ -f /usr/local/share/alpenglow/duos-map.txt ]; then
        printf "  ${P}%-20s${R} ok\n" "duos-map"
    else
        printf "  ${D}%-20s${R} ${ERRC}missing${R}\n" "duos-map"
        printf "  ${D}%-20s${R} ${D}Bundled with the image - reflash if missing${R}\n" ""
        ISSUES=$((ISSUES + 1))
    fi

    echo
    printf "  ${D}%-20s${R} " "issues"
    if [ "$ISSUES" -eq 0 ]; then
        printf "${P}none${R}\n"
        return 0
    fi
    printf "${ERRC}%s${R}\n" "$ISSUES"
    return 1
}

temp() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    local f
    if [ -r "$TEMP" ]; then
        printf "  ${D}%-12s${R} %s\n" "thermal" \
            "$(awk '{printf "%.1f°C",$1/1000}' "$TEMP")"
        printf "  ${D}%-12s${R} %s\n" "zone" \
            "$(cat /sys/class/thermal/thermal_zone0/type 2>/dev/null || echo thermal_zone0)"
    else
        err "thermal sensor not exposed by kernel"
        return 1
    fi
    f=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)
    case "$f" in
        ''|*[!0-9]*) ;;
        *) printf "  ${D}%-12s${R} %s MHz\n" "cpu freq" "$((f / 1000))" ;;
    esac
}

backup() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    [ $# -le 1 ] || { err "usage: all backup [dir]"; return 1; }
    local dir="${1:-.}" ts out
    if [ ! -d "$dir" ] || [ ! -w "$dir" ]; then
        err "cannot write to $dir"
        return 1
    fi
    dir=$(cd "$dir" && pwd) || { err "cannot resolve $dir"; return 1; }
    ts=$(date +%Y%m%d-%H%M%S)
    out="$dir/alpenglow-$ts.tar.gz"
    if ! ( cd / && tar czf "$out" home etc ); then
        rm -f "$out" 2>/dev/null || true
        err "backup failed"
        return 1
    fi
    echo "$out"
}

growfs() {
    case "${1:-}" in
        -h|--help) usage; return 0 ;;
        "") ;;
        *)
            err "growfs takes no arguments"
            printf 'usage: all growfs\n' >&2
            return 1
            ;;
    esac
    local root_dev disk partnum gr_out grc
    if [ "$(id -u)" -ne 0 ]; then
        err "growfs needs root"
        printf '%s  Run:%s doas all growfs\n' "$D" "$R" >&2
        return 1
    fi
    command -v findmnt >/dev/null 2>&1 || {
        err "findmnt not installed"
        printf '%s  Run:%s apk add util-linux\n' "$D" "$R" >&2
        return 1
    }
    root_dev=$(findmnt -n -o SOURCE /)
    if [ "$root_dev" = "/dev/root" ] || [ -z "$root_dev" ]; then
        root_dev=$(readlink -f /dev/root 2>/dev/null || echo "$root_dev")
    fi
    case "$root_dev" in
        *p[0-9]*)
            disk=$(echo "$root_dev" | sed 's/p[0-9]*$//')
            partnum=$(echo "$root_dev" | sed 's/.*p//')
            ;;
        *)
            disk=$(echo "$root_dev" | sed 's/[0-9]*$//')
            partnum=$(echo "$root_dev" | sed 's/.*[^0-9]//')
            ;;
    esac
    if [ -z "$disk" ] || [ -z "$partnum" ]; then
        err "cannot determine disk/partition from $root_dev"
        return 1
    fi
    command -v growpart >/dev/null 2>&1 || {
        err "growpart not installed"
        printf '%s  Run:%s apk add cloud-utils-growpart\n' "$D" "$R" >&2
        return 1
    }

    confirm "Expand rootfs to fill the SD card" || return 1

    printf "${P}Growing %s (partition %s)${R}\n" "$disk" "$partnum"
    printf "  ${D}before${R}  %s\n" "$(df -h / | awk 'NR==2{print $2" total, "$4" free"}')"

    gr_out=$(growpart "$disk" "$partnum" 2>&1)
    grc=$?
    case "$grc" in
        0) printf '  %s%s%s\n' "$D" "$gr_out" "$R" ;;
        1) printf "  ${D}partition already full; running resize2fs only${R}\n" ;;
        *)
            err "growpart failed (rc $grc)"
            printf '%s\n' "$gr_out" >&2
            return 1
            ;;
    esac
    resize2fs "$root_dev" || { err "resize2fs failed"; return 1; }

    printf "  ${D}after ${R}  %s\n" "$(df -h / | awk 'NR==2{print $2" total, "$4" free"}')"
}

ports() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    local raw rows
    if command -v ss >/dev/null 2>&1; then
        raw=$(ss -tlnp 2>/dev/null)
    elif command -v netstat >/dev/null 2>&1; then
        raw=$(netstat -tlnp 2>/dev/null)
    else
        err "neither ss nor netstat installed"
        printf '%s  Run:%s apk add iproute2\n' "$D" "$R" >&2
        return 1
    fi
    rows=$(printf '%s\n' "$raw" | awk '
    {
        loc = ""; proc = "-"; state = "-"
        if ($1 ~ /^tcp/) {                       # netstat: proto st recv send local foreign state pid/name
            loc = $4; state = $6; proc = $7
            sub(/^[0-9]+\//, "", proc)
        } else if ($1 == "LISTEN") {             # ss: State Recv-Q Send-Q local peer ...
            loc = $4; state = "LISTEN"
            if (match($0, /"[^"]+"/)) proc = substr($0, RSTART + 1, RLENGTH - 2)
        }
        if (loc == "") next
        scope = "lan"
        if (loc ~ /^\*:/ || loc ~ /^0\.0\.0\.0:/ || loc ~ /^\[::\]:/ || loc ~ /^:::/) scope = "exposed"
        else if (loc ~ /^127\./ || loc ~ /^\[::1\]:/ || loc ~ /^::1:/) scope = "loopback"
        n = split(loc, a, ":")
        printf "%s\t%s\t%s\t%s\n", loc, state, (proc == "" ? "-" : proc), scope
    }')
    printf "${P}Listening TCP ports${R}\n"
    if [ -z "$rows" ]; then
        printf '%s  No TCP listeners.%s\n' "$D" "$R"
        return 0
    fi
    { printf "ADDRESS\tSTATE\tPROCESS\tSCOPE\n"; printf '%s\n' "$rows"; } | format_table
    if printf '%s\n' "$rows" | grep -q 'exposed'; then
        printf '%s  exposed = reachable from any address (this image has no firewall)%s\n' "$D" "$R"
    fi
}

logs() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    [ $# -le 1 ] || { err "usage: all logs [service|kernel]"; return 1; }
    if [ -z "${1:-}" ] || [ "$1" = "kernel" ]; then
        local out
        out=$(dmesg 2>/dev/null) || {
            err "dmesg failed"
            [ "$(id -u)" -ne 0 ] && printf '%s  Run:%s doas all logs\n' "$D" "$R" >&2
            return 1
        }
        printf "${P}Kernel log${R}\n"
        printf '%s\n' "$out" | tail -n 100
        return 0
    fi
    local svc f st_rc=0 found=0
    svc="$1"
    printf "${P}Log: %s${R}\n" "$svc"
    rc-service "$svc" status 2>&1 || st_rc=$?
    for f in /var/log/"$svc"*; do
        [ -f "$f" ] || continue
        found=1
        echo
        printf "${P}%s${R}\n" "$f"
        tail -n 50 "$f"
    done
    [ "$found" = 1 ] && return 0
    [ "$st_rc" -eq 0 ] && return 0
    err "no status or log for: $svc"
    return 1
}

set_hostname() {
    case "${1:-}" in -h|--help) usage; return 0 ;; esac
    if [ $# -eq 0 ]; then
        cat /etc/hostname 2>/dev/null || hostname
        return 0
    fi
    [ $# -eq 1 ] || { err "usage: all hostname [name]"; return 1; }
    local name="$1"
    printf '%s' "$name" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9-]{0,62}$' || {
        err "invalid hostname (letters, digits, '-'; must start with a letter or digit)"
        return 1
    }
    if ! { printf '%s\n' "$name" > /etc/hostname; } 2>/dev/null; then
        err "cannot write /etc/hostname"
        printf '%s  Run:%s doas all hostname %s\n' "$D" "$R" "$name" >&2
        return 1
    fi
    hostname "$name" 2>/dev/null || true
    printf "  ${D}%-10s${R} %s\n" "hostname" "$name"
}

case "$1" in
    ""|help|-h|--help) usage ;;
    info)     shift; info "$@" ;;
    wifi)     shift; wifi "$@" ;;
    usb)      shift; usb "$@" ;;
    net)      shift; net "$@" ;;
    ssh)      shift; ssh_info "$@" ;;
    gpio)     shift; gpio "$@" ;;
    doctor)   shift; doctor "$@" ;;
    temp)     shift; temp "$@" ;;
    backup)   shift; backup "$@" ;;
    growfs)   shift; growfs "$@" ;;
    ports)    shift; ports "$@" ;;
    logs)     shift; logs "$@" ;;
    hostname) shift; set_hostname "$@" ;;
    *)
        err "unknown command: $1"
        suggest "$1" info net ports ssh logs hostname doctor temp backup growfs wifi usb gpio
        usage >&2
        exit 1
        ;;
esac
